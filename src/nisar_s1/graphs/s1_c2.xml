<graph id="s1_c2">
  <!-- Sentinel-1 IW SLC -> dual-pol covariance matrix C2 (VV/VH: C11, C12_real, C12_imag, C22),
       multilooked then terrain-corrected to a UTM grid and subset to the site. The complex cross
       term is kept, so the same dual-pol decompositions as for NISAR GSLC can be computed in Python
       (nisar_s1.polarimetry). Variables: ${ref} ${swath} ${aoi} ${rgLooks} ${azLooks} ${pixel}
       ${crs} ${region} ${out} -->
  <version>1.0</version>
  <node id="Read"><operator>Read</operator><parameters><file>${ref}</file></parameters></node>
  <node id="Split"><operator>TOPSAR-Split</operator><sources><sourceProduct refid="Read"/></sources>
    <parameters><subswath>${swath}</subswath><selectedPolarisations>VV,VH</selectedPolarisations>
      <wktAoi>${aoi}</wktAoi><enableSingleSwathMode>true</enableSingleSwathMode></parameters></node>
  <node id="Orb"><operator>Apply-Orbit-File</operator><sources><sourceProduct refid="Split"/></sources>
    <parameters><orbitType>Sentinel Precise (Auto Download)</orbitType><continueOnFail>true</continueOnFail></parameters></node>
  <node id="Cal"><operator>Calibration</operator><sources><sourceProduct refid="Orb"/></sources>
    <parameters><outputImageInComplex>true</outputImageInComplex><outputSigmaBand>true</outputSigmaBand></parameters></node>
  <node id="Deb"><operator>TOPSAR-Deburst</operator><sources><sourceProduct refid="Cal"/></sources><parameters/></node>
  <!-- crop to the site in radar geometry right after deburst: keeps memory low on small machines -->
  <node id="Crop"><operator>Subset</operator><sources><sourceProduct refid="Deb"/></sources>
    <parameters><geoRegion>${region}</geoRegion><copyMetadata>true</copyMetadata></parameters></node>
  <node id="Mat"><operator>Polarimetric-Matrices</operator><sources><sourceProduct refid="Crop"/></sources>
    <parameters><matrix>C2</matrix></parameters></node>
  <node id="ML"><operator>Multilook</operator><sources><sourceProduct refid="Mat"/></sources>
    <parameters><nRgLooks>${rgLooks}</nRgLooks><nAzLooks>${azLooks}</nAzLooks><outputIntensity>false</outputIntensity></parameters></node>
  <node id="TC"><operator>Terrain-Correction</operator><sources><sourceProduct refid="ML"/></sources>
    <parameters><demName>Copernicus 30m Global DEM</demName><pixelSpacingInMeter>${pixel}</pixelSpacingInMeter>
      <mapProjection>${crs}</mapProjection><imgResamplingMethod>BILINEAR_INTERPOLATION</imgResamplingMethod>
      <nodataValueAtSea>false</nodataValueAtSea></parameters></node>
  <node id="Sub"><operator>Subset</operator><sources><sourceProduct refid="TC"/></sources>
    <parameters><geoRegion>${region}</geoRegion><copyMetadata>false</copyMetadata></parameters></node>
  <node id="Write"><operator>Write</operator><sources><sourceProduct refid="Sub"/></sources>
    <parameters><file>${out}</file><formatName>BEAM-DIMAP</formatName></parameters></node>
</graph>
