<graph id="s1_interferogram">
  <!-- Sentinel-1 IW SLC pair -> flattened, topography-free interferogram (VV) and coherence,
       terrain-corrected and subset. No ESD: at Séchilienne the window lies in a single burst for both
       orbits (ESD only corrects phase jumps between bursts), and on the single-burst D139 pair it
       returned an all-zero product. No Goldstein filtering: the raw
       phase is compared with the (unfiltered) NISAR phase. The complex i/q bands are resampled
       (bilinear on the complex value, not on the wrapped phase).
       Variables: ${ref} ${sec} ${swath} ${aoi} ${cohWinRg} ${cohWinAz} ${rgLooks} ${azLooks}
       ${pixel} ${crs} ${region} ${out} -->
  <version>1.0</version>
  <node id="Read"><operator>Read</operator><parameters><file>${ref}</file></parameters></node>
  <node id="Read2"><operator>Read</operator><parameters><file>${sec}</file></parameters></node>
  <node id="Split"><operator>TOPSAR-Split</operator><sources><sourceProduct refid="Read"/></sources>
    <parameters><subswath>${swath}</subswath><selectedPolarisations>VV</selectedPolarisations>
      <wktAoi>${aoi}</wktAoi><enableSingleSwathMode>true</enableSingleSwathMode></parameters></node>
  <node id="Split2"><operator>TOPSAR-Split</operator><sources><sourceProduct refid="Read2"/></sources>
    <parameters><subswath>${swath}</subswath><selectedPolarisations>VV</selectedPolarisations>
      <wktAoi>${aoi}</wktAoi><enableSingleSwathMode>true</enableSingleSwathMode></parameters></node>
  <node id="Orb"><operator>Apply-Orbit-File</operator><sources><sourceProduct refid="Split"/></sources>
    <parameters><orbitType>Sentinel Precise (Auto Download)</orbitType><continueOnFail>true</continueOnFail></parameters></node>
  <node id="Orb2"><operator>Apply-Orbit-File</operator><sources><sourceProduct refid="Split2"/></sources>
    <parameters><orbitType>Sentinel Precise (Auto Download)</orbitType><continueOnFail>true</continueOnFail></parameters></node>
  <node id="BG"><operator>Back-Geocoding</operator><sources><sourceProduct refid="Orb"/><sourceProduct.1 refid="Orb2"/></sources>
    <parameters><demName>Copernicus 30m Global DEM</demName><demResamplingMethod>BILINEAR_INTERPOLATION</demResamplingMethod>
      <resamplingType>BISINC_5_POINT_INTERPOLATION</resamplingType><maskOutAreaWithoutElevation>true</maskOutAreaWithoutElevation></parameters></node>
  <node id="Ifg"><operator>Interferogram</operator><sources><sourceProduct refid="BG"/></sources>
    <parameters><subtractFlatEarthPhase>true</subtractFlatEarthPhase><includeCoherence>true</includeCoherence>
      <cohWinRg>${cohWinRg}</cohWinRg><cohWinAz>${cohWinAz}</cohWinAz><squarePixel>true</squarePixel></parameters></node>
  <node id="Deb"><operator>TOPSAR-Deburst</operator><sources><sourceProduct refid="Ifg"/></sources>
    <parameters><selectedPolarisations>VV</selectedPolarisations></parameters></node>
  <node id="Topo"><operator>TopoPhaseRemoval</operator><sources><sourceProduct refid="Deb"/></sources>
    <parameters><demName>Copernicus 30m Global DEM</demName><tileExtensionPercent>100</tileExtensionPercent></parameters></node>
  <node id="ML"><operator>Multilook</operator><sources><sourceProduct refid="Topo"/></sources>
    <parameters><nRgLooks>${rgLooks}</nRgLooks><nAzLooks>${azLooks}</nAzLooks><outputIntensity>false</outputIntensity></parameters></node>
  <node id="TC"><operator>Terrain-Correction</operator><sources><sourceProduct refid="ML"/></sources>
    <parameters><sourceBands/><demName>Copernicus 30m Global DEM</demName><pixelSpacingInMeter>${pixel}</pixelSpacingInMeter>
      <mapProjection>${crs}</mapProjection><imgResamplingMethod>BILINEAR_INTERPOLATION</imgResamplingMethod>
      <nodataValueAtSea>false</nodataValueAtSea><saveSelectedSourceBand>true</saveSelectedSourceBand>
      <saveLocalIncidenceAngle>true</saveLocalIncidenceAngle><saveIncidenceAngleFromEllipsoid>true</saveIncidenceAngleFromEllipsoid></parameters></node>
  <node id="Sub"><operator>Subset</operator><sources><sourceProduct refid="TC"/></sources>
    <parameters><geoRegion>${region}</geoRegion><copyMetadata>false</copyMetadata></parameters></node>
  <node id="Write"><operator>Write</operator><sources><sourceProduct refid="Sub"/></sources>
    <parameters><file>${out}</file><formatName>BEAM-DIMAP</formatName></parameters></node>
</graph>
